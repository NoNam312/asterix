{
  "manifest_version": 3,
  "name": "QuestLog Focus Lock",
  "version": "0.2.0",
  "description": "Blocks distracting sites until you reach your daily XP goal in QuestLog.",
  "permissions": ["storage", "alarms", "tabs", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://questlog-lake.vercel.app/*", "http://localhost:3000/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "QuestLog Focus Lock",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
